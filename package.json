{
  "name": "folio",
  "productName": "Folio",
  "version": "0.1.0",
  "description": "Extensible Markdown editor",
  "author": {
    "name": "floatflower",
    "email": "floatflower1029@gmail.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/floatflower/folio",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "predev": "node scripts/dev-app-name.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "package": "electron-vite build && electron-builder",
    "package:dir": "electron-vite build && electron-builder --dir"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@shikijs/rehype": "^4.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "codemirror": "^6.0.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "hast-util-to-string": "^3.0.1",
    "i18next": "^26.5.5",
    "katex": "^0.19.0",
    "lucide-react": "^1.61.0",
    "mermaid": "^12.2.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.1",
    "react-resizable-panels": "^4.14.8",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.3.5",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "subset-font": "^2.9.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "rehype-katex": {
      "katex": "$katex"
    }
  },
  "build": {
    "appId": "com.floatflower.folio",
    "productName": "Folio",
    "files": [
      "out/**/*",
      "package.json",
      "resources/fonts/coverage.json",
      "resources/fonts/OFL-*.txt"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ]
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown 文件",
        "description": "Markdown 文件",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "synopsis": "Extensible Markdown editor"
    }
  }
}
