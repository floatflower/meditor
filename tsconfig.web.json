{
  "compilerOptions": {
    "composite": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "paths": { "@/*": ["./src/renderer/src/*"] }
  },
  "include": ["src/shared/**/*", "src/renderer/src/**/*", "src/preload/index.d.ts", "src/main/menu.ts", "src/main/folder.ts", "src/main/i18n.ts"]
}
